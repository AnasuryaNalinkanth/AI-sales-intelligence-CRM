# Example environment configuration.

# Copy this file to .env and replace placeholder values with real secrets.

APP_NAME=AI Sales CRM
ENVIRONMENT=development
API_PREFIX=/api

CORS_ALLOWED_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_sales_crm
DB_USER=crm_app
DB_PASSWORD=your_mysql_password

# Optional: a full database URL that replaces the DB_* settings above. Leave unset for
# local MySQL. postgres:// and postgresql:// URLs use the psycopg driver automatically.
# Supabase app traffic: transaction pooler (port 6543) with DATABASE_POOL_MODE=serverless.
# Alembic migrations: direct or session-pooler connection (port 5432).
# DATABASE_URL=postgresql://your_user:your_password@your-host:6543/postgres
# pooled (default): in-process pool, as used with local MySQL.
# serverless: NullPool and no prepared statements, for an external transaction pooler.
DATABASE_POOL_MODE=pooled
# sslmode for PostgreSQL URLs that do not set ?sslmode= themselves (MySQL ignores it).
DATABASE_SSL_MODE=require

# AI provider

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Set AI_PROVIDER=ollama to use a local Ollama model instead of Gemini.
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=120
# Context window in tokens (2048-262144); the agent prompt and tools overflow Ollama's 4096 default.
OLLAMA_NUM_CTX=16384
# Total time allowed to interpret one /api/analytics/ask question before a 504.
ANALYTICS_ASK_TIMEOUT_SECONDS=60

# Legacy OpenAI settings (optional / compatibility only)

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agent settings

AGENT_ACTION_TTL_SECONDS=300
# Each tool round uses 2 graph steps; 12 allows 5 rounds (lookups, one scheduling tool, a retry) plus the reply.
AGENT_RECURSION_LIMIT=12

# AI request controls

OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1

# JWT authentication

JWT_SECRET_KEY=generate_a_secure_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Registration

ALLOW_PUBLIC_REGISTRATION=true
ALLOW_PUBLIC_REGISTRATION_IN_PRODUCTION=false

# Google Calendar sync (optional; disabled until all four values are set)

# OAuth client from Google Cloud Console (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google-calendar/callback
# Fernet key for encrypting stored OAuth tokens. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_API_TIMEOUT_SECONDS=10
